<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The macOS counterpart of airlock-tune.service + .timer: every 30 minutes,
     and tune.sh's own backoff decides whether a run does anything. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.airlock.tune</string>
  <key>ProgramArguments</key>
  <array>
    <string>@AIRLOCK_HOME@/current/tuning/tune.sh</string>
  </array>
  <key>WorkingDirectory</key><string>@AIRLOCK_HOME@/current</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>@PATH@</string>
    <key>TMPDIR</key><string>@TMPDIR@</string>
  </dict>
  <key>StartInterval</key><integer>1800</integer>
  <key>Nice</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/airlock/tune.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/airlock/tune.log</string>
</dict>
</plist>
