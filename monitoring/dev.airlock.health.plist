<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The macOS counterpart of airlock-health.service + .timer: every 5 minutes.
     launchd has no OnBootSec, so the first run is 5 minutes after load. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.airlock.health</string>
  <key>ProgramArguments</key>
  <array>
    <string>@AIRLOCK_HOME@/current/monitoring/run_health_check.sh</string>
  </array>
  <key>WorkingDirectory</key><string>@AIRLOCK_HOME@/current</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>@PATH@</string>
    <key>TMPDIR</key><string>@TMPDIR@</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>Nice</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/airlock/health.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/airlock/health.log</string>
</dict>
</plist>
